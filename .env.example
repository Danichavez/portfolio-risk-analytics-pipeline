# ============================================================
# Variables de Entorno — Pipeline de Métricas de Riesgo
# ============================================================
# Copiar a .env y completar con valores reales.
# NUNCA commitear el archivo .env con valores reales.

# --- Fuente de datos (MySQL) ---
SOURCE_JDBC_URL=jdbc:mysql://hostname:3306/database
SOURCE_USER=readonly_user
SOURCE_PASSWORD=<via-secrets-manager>

# --- Almacenamiento (S3) ---
S3_BUCKET=risk-analytics-bucket

# --- Data Warehouse (Redshift) ---
REDSHIFT_URL=jdbc:redshift://cluster.region.redshift.amazonaws.com:5439/database
REDSHIFT_USER=analytics_user
REDSHIFT_PASSWORD=<via-secrets-manager>
REDSHIFT_TEMP_DIR=s3://risk-analytics-bucket/redshift-temp/
REDSHIFT_IAM_ROLE=arn:aws:iam::ACCOUNT_ID:role/redshift-copy-role

# --- Parámetros del modelo ---
SCHEMA_ANALYTICS=analytics
PORTFOLIO_ID=PORTFOLIO
BENCHMARK_ID=BENCHMARK
BENCHMARK_MODE=AVG
TE_WINDOW_DAYS=120
RET_CAP=0.20

# --- CI/CD ---
AWS_REGION=us-east-1
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/github-actions-deploy
